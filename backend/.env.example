# Copy this file to .env and fill in your key.
# Backend membaca GEMINI_API_KEY otomatis lewat python-dotenv.
# Dapatkan API key gratis di https://aistudio.google.com/apikey

GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opsional, boleh dihapus kalau mau pakai default:
SUMMARIZE_MODEL=gemini-3.5-flash-lite
MAX_SUMMARY_INPUT_CHARS=60000
